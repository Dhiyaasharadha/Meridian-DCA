{
  "name": "meridian-dca-backend",
  "version": "1.0.0",
  "description": "Meridian DCA Yield-Optimized Engine Backend & Smart Contracts",
  "main": "api/src/server.ts",
  "scripts": {
    "build:contracts": "forge build",
    "test:contracts": "forge test -vv",
    "deploy:local": "forge script script/Deploy.s.sol --rpc-url http://127.0.0.1:8545 --broadcast",
    "dev:api": "ts-node-dev --respawn --transpile-only api/src/server.ts",
    "test:decision": "ts-node decision-engine/test/runDecisionTests.ts",
    "build": "tsc",
    "build:api": "tsc",
    "start": "ts-node api/src/server.ts",
    "seed": "ts-node scripts/seedDemo.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "viem": "^2.9.20"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "ts-node-dev": "^2.0.0"
  }
}
